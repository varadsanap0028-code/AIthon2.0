# ==============================================================================
# SARATHI PLATFORM CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure for your environment.
# Never commit real credentials, production secrets, or JWT keys.
# ==============================================================================

# Application Execution Mode: 'demo' (for jury presentations) or 'production' (for real deployments)
VITE_APP_MODE=demo

# Backend API Base URL
VITE_API_URL=http://localhost:4000

# ==============================================================================
# SMART CODING ASSESSMENT & INTEGRITY SYSTEM (V2)
# ==============================================================================
# Feature Flags (default false: preserves legacy behaviour)
ASSESSMENT_V2_ENABLED=false
VITE_ASSESSMENT_V2=false
ASSESSMENT_CAMERA_ENABLED=false

# Code Runner Driver: 'local-dev' (development only) | 'judge0' (production Docker) | 'sql'
RUNNER_DRIVER=local-dev
ASSESSMENT_RUNNER_TIMEOUT_MS=5000
ASSESSMENT_CODE_MAX_BYTES=20480

# Judge0 Docker Service Settings (when RUNNER_DRIVER=judge0)
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# Privacy & Integrity Settings
INTEGRITY_RETENTION_DAYS=90
ASSESSMENT_PASS_THRESHOLD=60

# ==============================================================================
# GOOGLE SINGLE SIGN-ON (SSO) CONFIGURATION
# ==============================================================================
# Google Cloud Console OAuth 2.0 Client ID for Web Applications
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================================================
# PLATFORM ADMIN SEED CONFIGURATION
# ==============================================================================
ADMIN_SEED_EMAIL=admin@sarathi.dev
ADMIN_SEED_PASSWORD=

