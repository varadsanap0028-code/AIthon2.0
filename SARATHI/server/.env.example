# ==============================================================================
# SARATHI BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure for your environment.
# Never commit real credentials, production secrets, or JWT keys.
# ==============================================================================

# Server Network Settings
PORT=4000
HOST=0.0.0.0

# Environment: 'development' or 'production'
NODE_ENV=development

# Application Mode: 'demo' (for local jury presentations) or 'production'
APP_MODE=demo

# Enable demo-session endpoints (MUST be false in production)
ENABLE_DEMO_AUTH=true

# JWT Signing Secret (MUST be a strong, cryptographically random secret in production)
JWT_SECRET=your-secure-random-jwt-secret-here
JWT_EXPIRES_IN=7d

# Permitted CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ==============================================================================
# AI PROVIDER CONFIGURATION (Server-side Only)
# To enable live AI generative responses, provide a Gemini API key or OpenAI key.
# If omitted, Sarathi runs in high-fidelity Local Knowledge Engine mode.
# Never expose these keys to the client or frontend.
# ==============================================================================
# Google Gemini API (Recommended)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Optional alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# SMART ASSESSMENT & SANDBOX RUNNER (V2)
# ==============================================================================
ASSESSMENT_V2_ENABLED=false
RUNNER_DRIVER=local-dev
ASSESSMENT_RUNNER_TIMEOUT_MS=5000
ASSESSMENT_CODE_MAX_BYTES=20480
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
INTEGRITY_RETENTION_DAYS=90
ASSESSMENT_PASS_THRESHOLD=60
ASSESSMENT_CAMERA_ENABLED=false

# ==============================================================================
# GOOGLE SINGLE SIGN-ON (SSO) CONFIGURATION
# ==============================================================================
# OAuth 2.0 Web Client ID from Google Cloud Console (Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: Restrict logins to a specific Google Workspace hosted domain (e.g., nit.edu)
# GOOGLE_ALLOWED_HD=
# Nonce expiration time in milliseconds (default: 600000 = 10 minutes)
GOOGLE_NONCE_TTL_MS=600000

# ==============================================================================
# PLATFORM ADMIN SEED CONFIGURATION
# ==============================================================================
# In production mode, ADMIN_SEED_PASSWORD must be configured with >= 12 chars.
# In development mode, if unset, an admin account with a random password will be created.
ADMIN_SEED_EMAIL=admin@sarathi.dev
ADMIN_SEED_PASSWORD=



