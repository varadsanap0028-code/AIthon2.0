{
  "name": "sarathi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "node ./node_modules/vite/bin/vite.js",
    "dev:backend": "node server/src/index.js",
    "server": "node server/src/index.js",
    "seed": "npm --prefix server run seed",
    "seed:admin": "node server/src/seeder/adminSeeder.mjs",
    "seed:admin-demo": "node server/src/seeder/adminDemoSeeder.mjs",
    "demo:admin": "node scripts/demo-admin.mjs",
    "smoke:admin": "node scripts/admin-smoke.mjs",
    "test": "npm --prefix server test",
    "test:server": "npm --prefix server test",
    "test:client": "vitest run",
    "test:all": "npm --prefix server test && vitest run",
    "check:links": "node scripts/check-links.mjs",
    "validate:seeds": "node scripts/validate-seeds.mjs",
    "validate:resources": "node scripts/validate-resources.mjs",
    "check:lines": "node scripts/check-line-limits.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/check-line-limits.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "isolated-vm": "^7.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
